extends layout

block content
  h1 #{tytul}
  
  div(style="background: white; padding: 20px; border-radius: 8px; border-left: 4px solid #4CAF50;")
    h3 Dane techniczne modelu:
    ul(style="font-size: 1.1em; line-height: 1.8;")
      li <strong>ID pliku:</strong> #{wydruk.id}
      li <strong>Materiał docelowy:</strong> #{wydruk.material}
      li <strong>Status projektu:</strong> #{wydruk.gotoweDoPobrania ? 'Zakończony i zweryfikowany' : 'W fazie testów i prototypowania'}
    
    h3 Opis elementu:
    p(style="font-size: 1.05em; line-height: 1.6; color: #444;") #{wydruk.opis}
    
    if wydruk.gotoweDoPobrania
      a.btn(href=`/downloads/${wydruk.id}.3mf` style="display: inline-block; margin-top: 15px;") Pobierz plik .3mf
      
    br
    a(href="/prints" style="display: inline-block; margin-top: 30px; text-decoration: none; color: #333; font-weight: bold;") &larr; Powrót do listy wydruków